# Local development only. Copy this file to .env and replace placeholder secrets.
DEBUG=True
SECRET_KEY=replace-this-with-a-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Exchange-rate integration (used in a later phase)
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
LOCAL_CURRENCY=EUR
EXCHANGE_RATE_TIMEOUT=5
# Illustrative fallback from the technical-test example; not a live exchange quote.
DEFAULT_EXCHANGE_RATE=0.85
